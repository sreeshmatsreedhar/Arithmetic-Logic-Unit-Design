module ALU (
    input [7:0] A, B,     // 8-bit input operands
    input [3:0] ALU_Sel,  // ALU operation selection
    output reg [7:0] ALU_Out, // ALU output
    output reg Zero       // Zero flag
);
  
always @(*) begin
    case(ALU_Sel)
        4'b0000: ALU_Out = A + B;  // Addition
        4'b0001: ALU_Out = A - B;  // Subtraction
        4'b0010: ALU_Out = A & B;  // AND
        4'b0011: ALU_Out = A | B;  // OR
        4'b0100: ALU_Out = A ^ B;  // XOR
        4'b0101: ALU_Out = A << 1; // Left Shift
        4'b0110: ALU_Out = A >> 1; // Right Shift
        4'b0111: ALU_Out = (A == B) ? 8'b00000001 : 8'b00000000; // Equal
        4'b1000: ALU_Out = (A > B) ? 8'b00000001 : 8'b00000000; // Greater than
        default: ALU_Out = 8'b00000000; 
    endcase
    
    
    Zero = (ALU_Out == 8'b00000000) ? 1 : 0;
end
  
endmodule
